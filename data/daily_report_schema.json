{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Mining Report",
  "description": "Authoritative content source for the Next.js gold, silver and copper supply-demand site",
  "$defs": {
    "evidence_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence", "source_url", "evidence_type", "period", "unit", "value"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "evidence_type": {"type": "string", "minLength": 1},
        "period": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "null"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "report_time", "summary", "windows", "part1_broadcasts", "part2_x_posts", "part3_news", "search_log", "dedup_log"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3,
      "description": "Optional version marker for current reports; omitted in historical reports"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Report date in YYYY-MM-DD format (the day being covered, not the generation day)",
      "example": "2026-07-05"
    },
    "report_time": {
      "type": "string",
      "format": "date-time",
      "description": "Actual ISO 8601 datetime when the report was completed; the daily task normally starts at 07:00 Beijing time",
      "example": "2026-07-06T07:00:00+08:00"
    },
    "summary": {
      "type": "string",
      "maxLength": 300,
      "description": "Chinese overview, no more than 300 characters, covering only the day's directional supply-demand changes by metal; exclude search process and itemized evidence"
    },
    "migration_note": {
      "type": "string",
      "description": "Optional provenance note used only for migrated historical reports"
    },
    "report_note": {
      "type": "string",
      "description": "Optional provenance note for post-publication report additions or corrections"
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part1", "part2", "part3"],
      "properties": {
        "part1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "description": "72-hour rolling window for broadcasts/interviews",
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "part2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "description": "Single-day window for X posts",
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "part3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "description": "Single-day window for news (English + Chinese)",
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "part1_broadcasts": {
      "type": "array",
      "description": "Broadcast/podcast/webcast/YouTube interviews found in the 72h window, after dedup",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "publish_date", "source_type", "metal_tags", "supply_demand", "summary"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "publish_date": {"type": "string", "format": "date"},
          "source_type": {
            "type": "string",
            "enum": ["podcast", "webcast", "youtube", "conference_interview", "panel", "keynote", "company_presentation"]
          },
          "guest": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "background": {"type": "string"}
            }
          },
          "metal_tags": {
            "type": "array",
            "items": {"type": "string", "enum": ["gold", "silver", "copper"]}
          },
          "primary_metal": {
            "type": "string",
            "enum": ["gold", "silver", "copper"],
            "description": "Single display section for this signal; required for new reports and must also appear in metal_tags"
          },
          "supply_demand": {
            "type": "string",
            "enum": ["supply", "demand", "both"]
          },
          "summary": {"type": "string"},
          "detail": {"type": "string"},
          "importance": {
            "type": "string",
            "description": "Optional substantive 2–4 sentence research conclusion, normally 80–300 Chinese characters; when present it must cover scale, mechanism, timing, comparison, or uncertainty rather than a generic label"
          },
          "verification_status": {
            "type": "string",
            "enum": ["verified", "unverified"],
            "description": "Required for new reports; unverified sources remain publishable but must be visibly labelled"
          },
          "verification_note": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence_claim"}
          },
          "companies": {"type": "array", "items": {"type": "string"}},
          "projects": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "part2_x_posts": {
      "type": "array",
      "description": "Verified X/Twitter posts in the single-day window",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["author", "handle", "publish_time", "metal_tags", "supply_demand", "url"],
        "properties": {
          "author": {"type": "string"},
          "handle": {"type": "string"},
          "publish_time": {
            "type": "string",
            "description": "ISO 8601 date-time, or YYYY-MM-DD when the source does not disclose a reliable time",
            "oneOf": [
              {"type": "string", "format": "date"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "metal_tags": {
            "type": "array",
            "items": {"type": "string", "enum": ["gold", "silver", "copper"]}
          },
          "primary_metal": {
            "type": "string",
            "enum": ["gold", "silver", "copper"],
            "description": "Single display section for this signal; required for new reports and must also appear in metal_tags"
          },
          "supply_demand": {
            "type": "string",
            "enum": ["supply", "demand", "both"]
          },
          "excerpt": {"type": "string"},
          "interpretation": {"type": "string"},
          "importance": {
            "type": "string",
            "description": "Optional substantive 2–4 sentence research conclusion; when present it must contain a concrete anchor and explain why the signal matters"
          },
          "verification_status": {
            "type": "string",
            "enum": ["verified", "unverified"],
            "description": "Required for new reports; unverified sources remain publishable but must be visibly labelled"
          },
          "verification_note": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence_claim"}
          },
          "url": {"type": "string", "format": "uri"},
          "source_channel": {
            "type": "string",
            "enum": ["browser_use", "rss_fallback", "web_access_xai", "twscrape", "playwright"]
          }
        }
      }
    },
    "part3_news": {
      "type": "array",
      "description": "Supply-demand news from English and Chinese sources in the single-day window",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "title", "url", "publish_time", "metal_tags", "supply_demand", "language"],
        "properties": {
          "source": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "publish_time": {
            "type": "string",
            "description": "ISO 8601 date-time, or YYYY-MM-DD when the source does not disclose a reliable time",
            "oneOf": [
              {"type": "string", "format": "date"},
              {"type": "string", "format": "date-time"}
            ]
          },
          "metal_tags": {
            "type": "array",
            "items": {"type": "string", "enum": ["gold", "silver", "copper"]}
          },
          "primary_metal": {
            "type": "string",
            "enum": ["gold", "silver", "copper"],
            "description": "Single display section for this signal; required for new reports and must also appear in metal_tags"
          },
          "supply_demand": {
            "type": "string",
            "enum": ["supply", "demand", "both"]
          },
          "excerpt": {"type": "string"},
          "interpretation": {"type": "string"},
          "importance": {
            "type": "string",
            "description": "Optional substantive 2–4 sentence research conclusion; when present it must contain a concrete anchor and explain why the signal matters"
          },
          "verification_status": {
            "type": "string",
            "enum": ["verified", "unverified"],
            "description": "Required for new reports; unverified sources remain publishable but must be visibly labelled"
          },
          "verification_note": {"type": "string"},
          "claims": {
            "type": "array",
            "items": {"$ref": "#/$defs/evidence_claim"}
          },
          "language": {
            "type": "string",
            "enum": ["en", "zh"]
          },
          "duplicate_of": {
            "type": ["string", "null"],
            "description": "If this news duplicates another entry, reference that entry's title or URL; null if unique"
          },
          "companies": {"type": "array", "items": {"type": "string"}},
          "projects": {"type": "array", "items": {"type": "string"}},
          "mining_com_source_note": {"type": "string"},
          "source_channel": {"type": "string", "enum": ["web", "playwright"]}
        }
      }
    },
    "search_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part1_searched", "part2_searched", "part3_sources_checked"],
      "properties": {
        "part1_searched": {"type": "boolean"},
        "part1_sources_checked": {"type": "array", "items": {"type": "string"}},
        "part1_result": {"type": "string"},
        "part2_searched": {"type": "boolean"},
        "part2_channel": {
          "type": "string",
          "enum": ["browser_use", "rss_fallback", "web_access_xai", "twscrape", "playwright", "failed"]
        },
        "part2_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "accounts_total", "accounts_completed", "accounts_failed", "attempted_channels", "selected_channel", "channel_errors", "notes"],
          "properties": {
            "status": {"type": "string", "enum": ["complete", "partial", "failed"]},
            "accounts_total": {"type": "integer", "minimum": 0},
            "accounts_completed": {"type": "integer", "minimum": 0},
            "accounts_failed": {"type": "integer", "minimum": 0},
            "attempted_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["web_access_xai", "twscrape", "playwright"]}},
            "selected_channel": {"type": ["string", "null"], "enum": ["web_access_xai", "twscrape", "playwright", "web_access_xai+twscrape", "web_access_xai+playwright", "twscrape+playwright", "web_access_xai+twscrape+playwright", "playwright+twscrape", null]},
            "channel_errors": {"type": "array", "items": {"type": "string"}},
            "notes": {"type": ["string", "array"], "items": {"type": "string"}}
          }
        },
        "part2_sources_checked": {"type": "array", "items": {"type": "string"}},
        "part2_result": {"type": "string"},
        "part3_searched": {
          "type": "boolean",
          "description": "True only when Part 3 collection completed, including a successful search with zero qualified results"
        },
        "part3_sources_checked": {"type": "array", "items": {"type": "string"}},
        "part3_result": {"type": "string"},
        "mining_com_source_note": {"type": "string"},
        "image_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {"type": "string", "enum": ["og_image", "ai_generated"]},
            "og_image_url": {"type": "string", "format": "uri"},
            "source_url": {"type": "string", "format": "uri"},
            "prompt": {"type": "string"},
            "note": {"type": "string"}
          }
        },
        "url_verification": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional audit summary of direct-source URL and fact checks",
          "required": ["checked", "passed", "failed"],
          "properties": {
            "checked": {"type": "integer", "minimum": 0},
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "failures": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "reason"],
                    "properties": {
                      "url": {"type": "string"},
                      "reason": {"type": "string"}
                    }
                  }
                ]
              }
            },
            "notes": {
              "oneOf": [
                {"type": "string"},
                {"type": "array", "items": {"type": "string"}}
              ]
            }
          }
        },
        "new_sources_discovered": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "dedup_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part1_deduped_urls", "part3_deduped_events"],
      "properties": {
        "part1_deduped_urls": {
          "type": "array",
          "items": {"type": "string"},
          "description": "URLs excluded from today's Part 1 because they appeared in the previous 2 days' reports"
        },
        "part2_deduped_urls": {
          "type": "array",
          "items": {"type": "string"},
          "description": "URLs excluded from today's Part 2 because they duplicated or did not add enough new information"
        },
        "part3_deduped_events": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Event descriptions merged as duplicates in Part 3"
        },
        "notes": {"type": "string"}
      }
    }
  }
}
